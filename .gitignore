# ── Grav core (ignorar todo excepto lo nuestro) ──────────────────
/system/
/vendor/
/bin/
/index.php
/composer.json
/composer.lock
/now.json
/images/
/webserver-configs/
CHANGELOG.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
LICENSE.txt
README.md
SECURITY.md
.github/
.phan/
.htaccess
# Grav 2: .env files configure the site (may hold secrets), .env.example ships with core
/.env*

# ── Migración a Grav 2 (migrate-grav): staging y asistente, temporales ──
/grav-2/
/migrate.php
/migrate-wizard.php
/.migrating
/.mg-promote.json
/.migration-complete

# ── Runtime generado ──────────────────────────────────────────────
/cache/
/logs/
/tmp/
/backup/
/assets/

# ── Contenido gestionado por SFTP ────────────────────────────────
user/pages/*
user/accounts/
user/data/
user/plugins/*
!user/plugins/topvoice-hooks/
!user/plugins/admin2-ca/
user/images/
# Admin Next branding uploads (logos, favicon), set per server from the admin
user/media/

# ── Temas de terceros (instalados con Grav, no nuestro código) ────
user/themes/quark/

# ── Config: gestionada 100% des de l'admin (per-servidor, NO versionada) ─
user/config/

# La config per entorn (user/env/<hostname>/) SÍ es versiona: hi viuen els
# ajustos que han de diferir a producció (errors amagats, cache activada).
# Els YAML dels plugins, en canvi, contenen credencials — mai al repo.
user/env/*/config/plugins/
# Grav 2 writes its salt and nonce key to the first config folder, which on a
# server with an env folder is this one. Secrets, never in the repo.
user/env/*/config/security.yaml
user/env/*/config/security-private.php
# Admin saves land there too; site settings are managed from the admin
user/env/*/config/site.yaml

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/