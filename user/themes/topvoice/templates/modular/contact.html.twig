{% set h = page.header %}
{% set active_lang = grav.language.getActive() %}

<section id="contact">
  <div class="contact-backdrop-grid">
    <div>
      <p class="section-tag">{{ h.section_tag }}</p>
      <h2 class="section-title">{{ h.section_title|nl2br }}</h2>
      <div class="divider"></div>
      <div class="contact-intro">{{ h.hire_intro|markdown|raw }}</div>
      <div style="margin-top:2.5rem;">
        {% include 'forms/form.html.twig' with { form: forms('contacte') } %}
      </div>
    </div>
    <div class="contact-details">
      {% if h.address %}
      <div class="contact-item">
        <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg></div>
        <span>{{ h.address }}</span>
      </div>
      {% endif %}
      {% if h.instagram %}
      <div class="contact-item">
        <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></div>
        <a href="https://www.instagram.com/{{ h.instagram|trim('@') }}/" class="ig" target="_blank" rel="noopener">@{{ h.instagram|trim('@') }}</a>
      </div>
      {% endif %}
      {% if h.youtube %}
      <div class="contact-item">
        <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="4"/><polygon points="10 9 15 12 10 15" fill="currentColor" stroke="none"/></svg></div>
        <a href="{{ h.youtube }}" class="ig" target="_blank" rel="noopener">YouTube</a>
      </div>
      {% endif %}
      {% if h.email %}
      <div class="contact-item">
        <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2 4 12 13 22 4"/></svg></div>
        <span>{{ h.email }}</span>
      </div>
      {% endif %}
      {% if h.phone1 or h.phone2 %}
      <div class="contact-item">
        <div class="contact-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6 6l1.94-1.94a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 15z"/></svg></div>
        {% if h.phone1 %}<a href="tel:{{ h.phone1|replace({' ': ''}) }}">{{ h.phone1 }}</a>{% endif %}
        {% if h.phone1 and h.phone2 %} / {% endif %}
        {% if h.phone2 %}<a href="tel:{{ h.phone2|replace({' ': ''}) }}">{{ h.phone2 }}</a>{% endif %}
      </div>
      {% endif %}
      <div class="contact-logos">
        <a href="https://rakelacademiadecant.my.canva.site/" target="_blank"><img src="{{ theme_url }}/images/rakel_logo_white.webp" height="50" alt="Rakel"></a>
        <a href="http://www.ramblamusic.cat/" target="_blank"><img src="{{ theme_url }}/images/RamblaMusic_logo_white.webp" height="40" alt="Rambla Music"></a>
      </div>
    </div>
  </div>
  <footer>
    <p>{{ 'SITE.FOOTER.COPYRIGHT'|t }}</p>
  </footer>
</section>

<a href="https://wa.me/{{ h.phone1|replace({' ': '', '+': ''}) ?: '636279326' }}" target="_blank" rel="noopener noreferrer" class="wa-btn" aria-label="WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
