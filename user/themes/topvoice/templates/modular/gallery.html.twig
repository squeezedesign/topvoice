{% set h = page.header %}

<section id="gallery">
  <div class="inner">
    <p class="section-tag">{{ h.section_tag }}</p>
    <h2 class="section-title">{{ h.section_title|nl2br }}</h2>
    <div class="divider"></div>
  </div>
  <div id="gallerySlider">
    {% for image in page.media.images %}
      {# Alt and caption come from the photo's .meta.yaml (Admin Next's media panel) #}
      {% set meta = image.metadata %}
      <div class="gallery-item">
        <img src="{{ image.cropZoom(800, 480).url() }}"
             data-full="{{ image.cropResize(1920, 1080).url() }}"
             alt="{{ meta.alt ?: 'Top Voice' }}"
             {% if meta.title %}title="{{ meta.title }}"{% endif %}
             loading="lazy">
      </div>
    {% endfor %}
  </div>
  <div class="inner">
    <div id="galleryDots"></div>
  </div>
</section>
