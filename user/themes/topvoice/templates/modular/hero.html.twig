{% set h = page.header %}

<section id="hero">
  <h1 aria-label="TopVoice">
    <img src="{{ theme_url }}/images/top_voice_logo.webp" width="420" height="176" alt="Top Voice · Cor Modern TGN">
  </h1>
  <div class="hero-desc">
    <p class="hero-sub">{{ h.subtitle }}</p>
    <p>{{ h.tagline }}</p>
  </div>
  <div class="hero-cta">
    <button class="btn btn-primary" onclick="goTo('contact')">{{ h.cta_primary }}</button>
    <button class="btn btn-outline" onclick="goTo('video')">{{ h.cta_secondary }}</button>
  </div>
  <div class="hero-events">
    {% include 'partials/concerts.html.twig' with { limit: h.max_concerts|default(1) } %}
  </div>

  <button type="button" class="hero-scroll" onclick="goTo('about')" aria-label="{{ 'SITE.HERO.SCROLL'|t }}">
    <span class="hero-scroll__line"></span>
    <svg class="hero-scroll__chevron" viewBox="2 7 20 10" width="18" height="9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
</section>
