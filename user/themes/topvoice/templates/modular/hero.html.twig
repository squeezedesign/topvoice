{% set h = page.header %}

<section id="hero">
  <h1 aria-label="TopVoice">
    <img src="{{ theme_url }}/images/top_voice_logo.webp" width="420" height="176" alt="Top Voice · Cor Modern TGN">
  </h1>
  <div class="hero-desc">
    <p class="hero-sub">{{ h.subtitle }}</p>
    <p>{{ h.tagline }}</p>
  </div>
  <div class="hero-cta">
    <button class="btn btn-primary" onclick="goTo('contact')">{{ h.cta_primary }}</button>
    <button class="btn btn-outline" onclick="goTo('video')">{{ h.cta_secondary }}</button>
  </div>
  <div class="hero-events">
    <div class="events-title">
      Propers concerts
    </div>
      <div class="class-event">
        <div class="event-datetime">
          <div class="event-day">04/08</div>
          <div class="event-hour">22h</div>
        </div>
        <div class="event-desc"><b>Calaceit</b>Setmana Cultural</div>
        <div class="event-format">Format Banda</div>
      </div>
  </div>
</section>
