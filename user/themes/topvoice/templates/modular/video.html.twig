{% set h = page.header %}
{% set video_id = '' %}
{% if h.video_url %}
  {% if 'youtu.be/' in h.video_url %}
    {% set video_id = h.video_url|split('youtu.be/')|last|split('?')|first %}
  {% elseif 'v=' in h.video_url %}
    {% set video_id = h.video_url|split('v=')|last|split('&')|first %}
  {% endif %}
{% endif %}
{% set poster_file = page.media.images()|first %}
{% set poster_url = poster_file ? poster_file.url : (video_id ? 'https://img.youtube.com/vi/' ~ video_id ~ '/maxresdefault.jpg' : '') %}

<section id="video">
  <div class="inner">
    <p class="section-tag">{{ h.section_tag }}</p>
    <h2 class="section-title">{{ h.section_title|nl2br }}</h2>
    <div class="divider"></div>
    <div class="video-wrap">
      <div class="video-placeholder"{% if video_id %} data-video-id="{{ video_id }}"{% endif %}>
        {% if poster_url %}
        <img src="{{ poster_url }}" alt="{{ h.section_title }}" loading="lazy">
        {% endif %}
        {% if video_id %}
        <button class="play-btn" onclick="playPromo()" aria-label="{{ 'SITE.VIDEO.PLAY'|t('Reproduir vídeo') }}">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </button>
        {% endif %}
      </div>
    </div>

    {% if config.site.social.youtube %}
    <div class="video-yt-link">
      <a href="{{ config.site.social.youtube }}" target="_blank" rel="noopener" class="btn btn-outline btn--yt">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><polygon points="10 9 15 12 10 15" fill="currentColor" stroke="none"/></svg>
        {{ 'SITE.VIDEO.YT_CHANNEL'|t }}
      </a>
    </div>
    {% endif %}
  </div>
  <div class="inner">
    {% include 'partials/concerts.html.twig' %}
  </div>
</section>
