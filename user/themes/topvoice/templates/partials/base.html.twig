<!DOCTYPE html>
<html lang="{{ grav.language.getActive() ?: 'ca' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {# Disable native scroll restoration before the browser can restore a mid-page
     position on reload — keeps scroll-driven backgrounds initialising at the top. #}
  <script>if ('scrollRestoration' in history) history.scrollRestoration = 'manual';</script>
  <title>{{ page.title }} {% if page.title != site.title %}· {{ site.title }}{% endif %}</title>

  {% if page.header.description is defined %}
  <meta name="description" content="{{ page.header.description }}">
  {% else %}
  <meta name="description" content="{{ site.metadata.description }}">
  {% endif %}

  <link rel="icon" type="image/png" href="{{ theme_url }}/images/favicon/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="{{ theme_url }}/images/favicon/favicon.svg">
  <link rel="shortcut icon" href="{{ theme_url }}/images/favicon/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ theme_url }}/images/favicon/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Top Voice">
  <link rel="manifest" href="{{ theme_url }}/images/favicon/site.webmanifest">

  <link rel="stylesheet" href="{{ theme_url }}/css/slick.css">
  <link rel="stylesheet" href="{{ theme_url }}/css/style.css">

  {% for lang in grav.languages.supported %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ page.translateUrl(lang) }}">
  {% endfor %}
</head>
<body>

<script>window.THEME_URL = '{{ base_url_simple }}/user/themes/topvoice';</script>

<div id="site-bg" aria-hidden="true">
  <div class="bg-blobs"></div>
  <div class="bg-tint"></div>
  <div id="bg-leopard"></div>
</div>

<div class="overlay" id="overlay" onclick="closeMenu()"></div>

{% include 'partials/offcanvas.html.twig' %}
{% include 'partials/nav.html.twig' %}

<main>
{% block content %}{% endblock %}
</main>

<script src="{{ theme_url }}/js/vendor/jquery-3.7.1.min.js"></script>
<script src="{{ theme_url }}/js/vendor/slick.min.js"></script>
<script src="{{ theme_url }}/js/vendor/gsap.min.js"></script>
<script src="{{ theme_url }}/js/vendor/ScrollTrigger.min.js"></script>
<script src="{{ theme_url }}/js/scripts.js"></script>
</body>
</html>
