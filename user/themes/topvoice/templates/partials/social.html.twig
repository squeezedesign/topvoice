{# Open Graph and Twitter card for link previews (WhatsApp, Facebook, X…).
   og:url and og:locale come from partials/alternates. Expects page_title and
   page_description from base.html.twig. The image is a 1200×630 JPEG crop of
   a gallery photo, kept in the theme so it does not depend on page media. #}
{% set og_image = uri.rootUrl(true) ~ 'images/og-image.jpg'|theme_asset %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Top Voice">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ 'SITE.SOCIAL.IMAGE_ALT'|t }}">
<meta name="twitter:card" content="summary_large_image">
